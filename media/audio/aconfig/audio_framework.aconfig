# Top level framework (android.media) flags
# Only add flags here which must be included in framework.jar
# Flags used in both framework.jar and native can be added here
#
# Please add flags in alphabetical order.

package: "android.media.audio"
container: "system"

# go/keep-sorted start block=yes newline_separated=yes by_regex=name:\s*"([^"]+)"
flag {
    name: "ambisonics_support_api"
    namespace: "media_audio"
    description: "Add API support for ambisonics audio."
    bug: "446025781"
    is_exported: true
}

flag {
    name: "amsco_available_api"
    namespace: "media_audio"
    description: "Reflag API checking AMSCO availability to separate from implementation"
    bug: "460462656"
    is_exported: true
}

flag {
    name: "assistant_volume_control"
    namespace: "media_audio"
    description: "Implement the logic for having STREAM_ASSISTANT lead the volume control"
    is_exported: true
    bug: "416329698"
}

flag {
    name: "audio_focus_desktop"
    namespace: "media_audio"
    description: "audio focus for desktop behaviors"
    bug: "416963897"
}

flag {
    name: "audio_focus_isolation"
    namespace: "media_audio"
    description: "Enables operation to isolate a uid's audio focus management."
    bug: "428808570"
}

flag {
    name: "audio_policy_builders_api"
    namespace: "media_audio"
    description: "Expand the creation APIs for AudioTrack source and AudioRecord sink with Builders"
    bug: "416965224"
    is_exported: true
}

flag {
    name: "auto_public_volume_api_hardening"
    namespace: "media_audio"
    description: "On AAOS, make volume and ringer SDK APIs in AudioManager no-ops."
    bug: "302751899"
}

flag {
    name: "ble_hearing_aid_device"
    namespace: "media_audio"
    description: "Add BLE hearing aid device category"
    bug: "443740527"
    is_exported: true
}

flag {
    name: "ble_peripheral_devices"
    namespace: "media_audio"
    description: "Add devices for BLE peripheral mode"
    bug: "423053144"
    is_exported: true
}

flag {
    name: "bt_audio_disconnect_api"
    namespace: "media_audio"
    description: "Add API to notify audio for SCO disconnection under AMSCO."
    bug: "454472259"
    is_exported: true
}

flag {
    name: "bt_device_category_api"
    namespace: "media_audio"
    description: "Expose BT device categories to mainline modules"
    bug: "460462975"
    is_exported: true
}

flag {
    name: "codec_provenance_api"
    namespace: "media_audio"
    description: "Add API to specify the original codec for an audio track."
    bug: "447704057"
    is_exported: true
}

flag {
    name: "concurrent_audio_record_bypass_permission"
    namespace: "media_audio"
    description:
       "New privileged permission to allow bypassing concurrent audio"
       "capture rules."
    bug: "374751406"
    is_exported: true
}

flag {
    name: "dap_injection_starve_management"
    namespace: "media_audio"
    description: "Dynamic AudioPolicy management of injection starvation"
    bug: "416965224"
    is_exported: true
}

flag {
    name: "deprecate_stream_bt_sco"
    namespace: "media_audio"
    description: "Deprecate STREAM_BLUETOOTH_SCO"
