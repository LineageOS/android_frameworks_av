# Media Recorder feature flags.

package: "android.media.mediarecorder"
container: "system"

# go/keep-sorted start block=yes newline_separated=yes by_regex=name:\s*"([^"]+)"
flag {
  name: "apv_recording_support"
  is_exported: true
  namespace: "codec_fwk"
  description: "Feature flag for APV Support in MediaRecorder"
  bug: "418815095"
}

flag {
  name: "quality_setting_support"
  is_exported: true
  namespace: "codec_fwk"
  description: "Feature flag for setting Video Quality in MediaRecorder"
  bug: "444502772"
}
# go/keep-sorted end