# Codec framework feature flags.

package: "android.media.codec"
container: "system"

# go/keep-sorted start block=yes newline_separated=yes by_regex=name:\s*"([^"]+)"
flag {
  name: "agtm_metadata"
  is_exported: true
  namespace: "codec_fwk"
  description: "Feature flag for AGTM metadata support"
  bug: "467136864"
}

