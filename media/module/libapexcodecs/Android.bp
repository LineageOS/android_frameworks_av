package {
    default_applicable_licenses: ["frameworks_av_license"],
}

cc_defaults {
    name: "libcom.android.media.swcodec.apexcodecs-defaults",

    header_libs: [
        "libbase_headers",
        "libcodec2_internal",
    ],

    srcs: [
        "ApexCodecs.cpp",
        "ApexCodecsImpl.cpp",
    ],

    shared_libs: [
        "libbase",
        "libcodec2",
        "libnativewindow",
    ],

    static_libs: [
        "android.media.swcodec.flags-aconfig-cc",
    ],

    export_include_dirs: ["include"],

    local_include_dirs: ["private"],

    export_shared_lib_headers: [
        "libbase",
        "libnativewindow",
    ],
}

cc_library_headers {
    name: "libcom.android.media.swcodec.apexcodecs-header",
    visibility: [
        "//frameworks/av/apex:__subpackages__",
        "//frameworks/av/media/codec2/hal/client",
    ],
    export_include_dirs: ["include"],
}

cc_library {
    name: "libcom.android.media.swcodec.apexcodecs",
    defaults: [
        "libcom.android.media.swcodec.apexcodecs-defaults",
        // Temporarily disable bti-report flag until GNU Note
        // is added properly to libopus_lfi
        "no_bti",
    ],

    visibility: [
        "//frameworks/av/apex:__subpackages__",
        "//frameworks/av/media/codec2/hal/client",
        ":__subpackages__",
    ],

    srcs: [
        "ApexCodecsStoreImpl.cpp",
    ] + select(release_flag("RELEASE_APEX_CODECS"), {
        true: [
            "C2ApexAacDec.cpp",
            "DrcPresModeWrapRustAac.cpp",
        ],
        default: [],
    }),

    shared_libs: select(release_flag("RELEASE_APEX_CODECS"), {
        true: [
            "libaconfig_storage_read_api_cc",
            "libcodec2_soft_common",
            "libcodec2_vndk",
            "liblog", // for ALOG
            "libstagefright_foundation", // for ColorUtils and MIME
            "libcutils", // for <cutils/properties.h>
        ],
        default: [],
    }),

    cflags: select(release_flag("RELEASE_APEX_CODECS"), {
        true: [
            "-DENABLE_APEX_CODECS",
            "-Wno-unused-function",
        ],
        default: [],
    }),

    static_libs: [
        "android.media.codec-aconfig-cc",
    ] + select(release_flag("RELEASE_APEX_CODECS"), {
        true: [
            "libaac",
            "libaac_ffi",
        ],
        default: [],
    }),

    arch: {
        arm64: {
            lfi_supported: true,
            static_libs: select(release_flag("RELEASE_APEX_CODECS"), {
                true: [
                    "liblfi",
                    "libopus_lfi",
                ],
                default: [],
            }),
            srcs: select(release_flag("RELEASE_APEX_CODECS"), {
                true: [
                    "C2ApexOpusDec.cpp",
                ],
                default: [],
            }),
        },
    },

    min_sdk_version: "apex_inherit",
    version_script: "libcom.android.media.swcodec.apexcodecs.map.txt",
    stubs: {
        symbol_file: "libcom.android.media.swcodec.apexcodecs.map.txt",
        versions: ["36"],
    },

    apex_available: [
        "com.android.media.swcodec",
    ],
}
